    {
      "name": "reconcile_apply",
      "title": "Apply reviewed Docket reconciliation",
      "description": "Apply one explicit disposition per selected path using a source-bound plan version. Semantic choices require reasons; terminal imports require acceptCompletion and local transition/dependency policy. Preserve original and planned bytes in a local recovery journal, keep unrelated code/drafts, and regenerate derived index content. No Git history or remote actions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "selection": {
            "type": "object",
            "properties": {
              "sourceRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sourceRoot": {
                "type": "string",
                "maxLength": 2048
              },
              "saved": {
                "default": false,
                "type": "boolean"
              },
              "baseRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "paths": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            },
            "required": [
              "sourceRef",
              "paths"
            ],
            "additionalProperties": false
          },
          "expectedVersion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "choices": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 256
                },
                "disposition": {
                  "type": "string",
                  "enum": [
                    "keep-local",
                    "merge-compatible",
                    "take-incoming",
                    "resolve"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "source": {
                  "type": "string",
                  "maxLength": 65536
                },
                "acceptCompletion": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "disposition"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "selection",
          "expectedVersion",
          "choices"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
