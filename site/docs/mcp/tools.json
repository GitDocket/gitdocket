                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "paths": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            },
            "required": [
              "sourceRef",
              "paths"
            ],
            "additionalProperties": false
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
