{
  "name": "docket-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitDocket/gitdocket.git"
  },
  "homepage": "https://gitdocket.com",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@hono/node-server": "1.19.15",
    "fast-uri": "3.1.6",
    "hono": "4.13.5",
    "ip-address": "10.7.0",
    "qs": "6.16.0"
  },
  "scripts": {
    "docket": "bun packages/cli/src/index.ts",
    "export-public": "bun scripts/export-public.ts",
    "sync-shipped": "bun scripts/sync-shipped.ts",
    "dev": "bun packages/cli/src/index.ts serve --watch",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "1.3.14",
    "typescript": "^5.9.3"
  }
}
