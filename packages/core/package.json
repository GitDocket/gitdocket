{
  "name": "@gitdocket/core",
  "version": "0.6.0",
  "type": "module",
  "description": "The typed file-and-graph engine behind GitDocket.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitDocket/gitdocket.git",
    "directory": "packages/core"
  },
  "homepage": "https://gitdocket.com",
  "engines": {
    "bun": ">=1.3.14"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cache": "./src/cache.ts",
    "./telemetry": "./src/telemetry.ts",
    "./telemetry-report": "./src/telemetry-report.ts",
    "./orientation": "./src/orientation.ts",
    "./overview": "./src/overview.ts",
    "./state-of-play": "./src/state-of-play.ts",
    "./task-progress": "./src/task-progress-view.ts"
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.json",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.5.4"
  }
}
